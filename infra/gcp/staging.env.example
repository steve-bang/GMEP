# Copy to staging.env (git-ignored: infra/gcp/*.env) and point INFRA_ENV_FILE at it.
#   cp infra/gcp/staging.env.example infra/gcp/staging.env
#   INFRA_ENV_FILE=infra/gcp/staging.env DRY_RUN=1 infra/gcp/00-bootstrap.sh
# Placeholders only. No secret value ever goes into this file.

PROJECT_ID=<PROJECT_ID>
ENV_NAME=staging
# REGION=asia-southeast1

# Billing (00-bootstrap.sh, 50-budget.sh)
BILLING_ACCOUNT_ID=<XXXXXX-XXXXXX-XXXXXX>
# Only when the project does not exist yet (needs permission on the org/folder)
# CREATE_PROJECT=1
# PARENT_FLAG=--organization=<ORG_ID>        # or --folder=<FOLDER_ID>

# Firestore (00-bootstrap.sh)
ENABLE_PITR=false                 # true for prod (point-in-time recovery, 7 days)
DELETE_PROTECTION=false           # true for prod
BACKUP_RETENTION=7d               # [Cần xác nhận] retention periods are an open decision

# GitHub Workload Identity Federation (10-iam.sh)
GITHUB_REPOSITORY=<OWNER>/<REPO>

# Cloud Run (30-deploy-service.sh)
APP_BASE_URL=https://<staging-domain-or-run.app-url>
CRON_TENANT_ID=<company id created by the bootstrap data task>
MIN_INSTANCES=0                   # prod: 1 (ADR 0001, cold start vs NFR 2 s)
MAX_INSTANCES=5
# Set EMAIL_FROM to wire EMAIL_SMTP_URL from Secret Manager (needs the SMTP adapter, branch feat/email-smtp-adapter-deploy-guide)
# EMAIL_FROM=GMEP <no-reply@<domain>>

# Budget alert (50-budget.sh), in USD
BUDGET_USD=100
