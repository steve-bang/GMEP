# GMEP server-side configuration. Copy to .env.local for development. NEVER commit real values.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_* variables exist by design, ADR 0001 R-12).

# local | dev | staging | prod. `local` refuses to start without the emulator hosts below.
GMEP_ENV=local
# firestore (default) | memory (tests/local only; rejected outside GMEP_ENV=local)
GMEP_DATA_BACKEND=firestore

# Demo project id for the Firebase Emulator Suite. For real environments use the GCP project id
# of the environment (the owner has not created the projects yet).
GCLOUD_PROJECT=demo-gmep
# Server-only Identity Toolkit key. The emulator accepts any value; real value comes from Secret Manager.
FIREBASE_API_KEY=demo-api-key

# Emulator Suite (start with `pnpm emulators`). Leave unset in real environments.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Extra allowed Origin for state-changing requests (the request's own origin is always allowed).
# APP_ORIGIN=https://app.example.vn

# Session: absolute lifetime (hours) and idle timeout (minutes) [Cần xác nhận: per-role values, D-05]
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Retention of Idempotency-Key records (hours); also configure a Firestore TTL policy on idempotencyKeys.expiresAt
IDEMPOTENCY_TTL_HOURS=24

# LOG_LEVEL=info
